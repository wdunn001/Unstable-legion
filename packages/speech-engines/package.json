{
  "name": "@unstable-legion/speech",
  "version": "0.0.1",
  "description": "Browser speech mesh capability (ASR + TTS) — `SpeechEngine`/`TtsEngine` interfaces, a transformers.js Whisper implementation and a kokoro-js Kokoro-82M implementation, WebAudio decode/resample + WAV encode helpers, one Web Worker host + client per direction, and the `transcribe`/`synthesize` mesh tools built on top. Backs the `asr.transcribe`/`tts.synthesize` skills defined in `@unstable-legion/core`'s `speech.ts`.",
  "license": "BSL-1.1",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "import": "./dist/esm/worker.js"
    },
    "./tts-worker": {
      "types": "./dist/types/ttsWorker.d.ts",
      "import": "./dist/esm/ttsWorker.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').readdirSync('dist/cjs').filter(f=>f.endsWith('.js')).forEach(f=>require('fs').renameSync('dist/cjs/'+f,'dist/cjs/'+f.replace(/\\.js$/,'.cjs')))\"",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "node --test --import tsx test/*.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@unstable-legion/core": "0.0.1",
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wdunn001/unstable-legion.git",
    "directory": "packages/speech-engines"
  },
  "keywords": ["speech", "asr", "tts", "whisper", "kokoro", "transformers.js", "mesh", "browser-ai"]
}
