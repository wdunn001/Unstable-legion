# Deploy-host .env for `docker compose build` (legion-chat: builds both
# apps/chat, served at `/`, and apps/demo, served at `/classic/` — see
# apps/chat/Dockerfile and README.md's M6 root-swap note).
# Copy to `.env` next to docker-compose.yml on the deploy host and fill in
# real values — this file itself must stay placeholder-only, never commit
# real credentials.
#
# GOTCHA (found 2026-07-15, M0.5 reliability spike): these four vars are
# ONLY read at `docker compose build` time (Vite inlines import.meta.env.
# VITE_* into the bundle — there's no runtime override, see
# apps/demo/Dockerfile). If this .env is missing or blank, the build
# SILENTLY succeeds with STUN-only ICE config — no error, no warning, the
# self-hosted coturn just never gets used even though it's running fine.
# That's exactly what happened here: legion-coturn ran healthy for days
# while the deployed demo had zero TURN wired in. Run
# scripts/verify-turn-baked.sh after every build to catch this class of
# regression before it reaches users.

# Comma/space separated. Two rules, both learned the hard way:
# 1. Only advertise transports your relay ACTUALLY accepts end to end —
#    unreachable variants make every ICE attempt try them, fail with "Failed
#    to establish connection", flood the console with 701s and slow
#    negotiation.
# 2. If your relay DOES accept TCP (coturn does by default — `no-tcp-relay`
#    only disables RFC 6062 peer-side TCP, not the client listener), ALWAYS
#    list the ?transport=tcp variant alongside UDP. A bare `turn:` URL
#    gathers UDP relay candidates ONLY, so users on UDP-blocking firewalls
#    (corporate/hotel/campus networks) silently get zero relay path even
#    though the relay would have served them fine over TCP. Found 2026-08-08:
#    "trying to connect but can't — TURN firewall issue" reports were exactly
#    this.
VITE_TURN_URLS=turn:YOUR_RELAY_HOST:3478,turn:YOUR_RELAY_HOST:3478?transport=tcp
VITE_TURN_USERNAME=REPLACE_ME
# Read this from your relay's turnserver.conf — never commit a real credential.
VITE_TURN_CREDENTIAL=REPLACE_ME
VITE_TURN_USE_DEFAULT=0

# ── OpenPanel analytics (apps/chat) ──────────────────────────────────────
# OpenPanel is the ONLY analytics stack, and self-hosting it is the point (see
# docs/TELEMETRY.md). Like the TURN vars above, these are read ONLY at
# `docker compose build` (Vite inlines import.meta.env.VITE_*).
#
# USER ACTION REQUIRED to enable analytics:
#   1. Create a project in your OpenPanel dashboard.
#   2. Add your deployment's origin to that project's CORS allow-list
#      (OpenPanel matches origins EXACTLY — no subdomain wildcards).
#   3. Copy the project's public client id into VITE_OPENPANEL_CLIENT_ID below
#      and rebuild.
# Leave VITE_OPENPANEL_CLIENT_ID blank/placeholder to ship WITHOUT tracking —
# the app treats an absent/placeholder id as a hard no-op (never breaks).
VITE_OPENPANEL_CLIENT_ID=
# Point these at your own OpenPanel instance:
#   VITE_OPENPANEL_API_URL=https://YOUR_INGEST_HOST/v1
#   VITE_OPENPANEL_SCRIPT_URL=https://YOUR_INGEST_HOST/assets/site.js
VITE_OPENPANEL_API_URL=
VITE_OPENPANEL_SCRIPT_URL=

# ── Deployment (docker-compose.yml) ──────────────────────────────────────
# Everything environment-specific lives here, never in committed files.
# These target an nginx-proxy + acme-companion front; adapt or ignore if you
# terminate TLS some other way.
LEGION_VIRTUAL_HOST=legion.localhost
LEGION_LETSENCRYPT_HOST=
LEGION_LETSENCRYPT_EMAIL=
# Host dir holding the model mirror, bind-mounted read-only at /webllm.
# Populate with scripts/populate-webllm-mirror.sh.
LEGION_WEBLLM_MIRROR_DIR=./webllm-mirror
LEGION_PROXY_NETWORK=nginx-proxy
