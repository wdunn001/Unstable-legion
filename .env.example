# Deploy-host .env for `docker compose build` (legion-chat: builds both
# apps/chat, served at `/`, and apps/demo, served at `/classic/` — see
# apps/chat/Dockerfile and README.md's M6 root-swap note).
# Copy to `.env` next to docker-compose.yml on the deploy host and fill in
# real values — this file itself must stay placeholder-only, never commit
# real credentials.
#
# GOTCHA (found 2026-07-15, M0.5 reliability spike): these four vars are
# ONLY read at `docker compose build` time (Vite inlines import.meta.env.
# VITE_* into the bundle — there's no runtime override, see
# apps/demo/Dockerfile). If this .env is missing or blank, the build
# SILENTLY succeeds with STUN-only ICE config — no error, no warning, the
# self-hosted coturn just never gets used even though it's running fine.
# That's exactly what happened here: legion-coturn ran healthy for days
# while the deployed demo had zero TURN wired in. Run
# scripts/verify-turn-baked.sh after every build to catch this class of
# regression before it reaches users.

VITE_TURN_URLS=turn:legion.codecai.net:3478
VITE_TURN_USERNAME=legion
VITE_TURN_CREDENTIAL=REPLACE_ME_from_deploy_host_/storage/coturn/turnserver.conf
VITE_TURN_USE_DEFAULT=0
